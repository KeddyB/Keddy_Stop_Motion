{
  "expo": {
    "name": "Keddy Stop Motion",
    "slug": "keddyStopMotion",
    "scheme": "keddystopmotion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.keddyb.keddyStopMotion",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Keddy Stop Motion uses your camera to capture frames for your animations.",
        "NSPhotoLibraryUsageDescription": "Keddy Stop Motion accesses your photo library to save and import frames.",
        "NSPhotoLibraryAddUsageDescription": "Keddy Stop Motion saves your finished movies and animations to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.keddyb.keddyStopMotion",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Keddy Stop Motion uses your camera to capture frames for your animations."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Keddy Stop Motion needs access to your gallery to save and import animations.",
          "savePhotosPermission": "Keddy Stop Motion needs access to save animations to your gallery."
        }
      ],
      "expo-audio",
      "expo-image",
      "./with-ffmpeg.js"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "86baf9cd-7d7a-4391-9733-f7fa79fc8a04"
      }
    }
  }
}
